# Copy values into your shell or a local .env file. Do not commit real values.
CONFLUENCE_BASE_URL=https://confluence.example.com
CONFLUENCE_TOKEN=<personal-access-token>
CONFLUENCE_AUTH_MODE=bearer
CONFLUENCE_EMAIL=<only-required-for-basic-auth>
CONFLUENCE_REQUEST_DELAY_SECONDS=0.5
CONFLUENCE_MAX_RETRIES=3
CONFLUENCE_INITIAL_BACKOFF_SECONDS=1

# Needed only by discover_confluence_pages.py.
CONFLUENCE_PAGE_ID=<parent-page-id>
CONFLUENCE_PLATFORM=data-center
CONFLUENCE_MAX_DEPTH=3
CONFLUENCE_EXCLUDED_PAGE_IDS=
CONFLUENCE_OUTPUT_PAGE_ID_FILE=

OCI_CONFIG_FILE_PATH=<path-to-your-oci-config>
OCI_PROFILE_NAME=DEFAULT
OCI_COMPARTMENT_ID=<compartment-ocid>
OCI_ENDPOINT=https://inference.generativeai.<region>.oci.oraclecloud.com
OCI_EMBEDDING_MODEL_ID=<embedding-model-id>
OCI_CHAT_MODEL_ID=<chat-model-id>
OCI_CHAT_REQUEST_FORMAT=openai
OCI_CHAT_MAX_TOKENS=800
OCI_CHAT_TEMPERATURE=0

ORACLE_VECTOR_HOST=<host>
ORACLE_VECTOR_PORT=1521
ORACLE_VECTOR_SERVICE_NAME=FREEPDB1
ORACLE_VECTOR_USERNAME=<username>
ORACLE_VECTOR_PASSWORD=<password>
ORACLE_VECTOR_TABLE_NAME=RAG_EMBEDDED_CHUNKS

OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_NAME=rag_embedded_chunks_v1
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTIFICATES=true
OPENSEARCH_VECTOR_ENGINE=faiss
OPENSEARCH_VECTOR_SPACE_TYPE=cosinesimil

# Tune separately for each backend after evaluating representative questions.
RAG_MAX_COSINE_DISTANCE=0.45
RAG_MIN_KNN_SCORE=0.75
