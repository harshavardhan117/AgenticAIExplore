		{
			"id": "mi8HpszJ",
			"type": "text",
			"x": 1340,
			"y": 1244,
			"width": 1263.958611092895,
			"height": 148.75,
			"angle": 0,
			"strokeColor": "#343a40",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
