    {"id":"memory-test","type":"rectangle","x":70,"y":2290,"width":780,"height":130,"angle":0,"strokeColor":"#f08c00","backgroundColor":"#fff9db","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"g2","roundness":{"type":3},"seed":101,"version":1,"versionNonce":101,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"memory-test-text","type":"text","x":95,"y":2312,"width":700,"height":75,"angle":0,"strokeColor":"#5f3dc4","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"g3","roundness":null,"seed":102,"version":1,"versionNonce":102,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Three-question ownership test\n\nStored as a field for future calls?        → association / has-a\nCreated and logically owned internally?    → composition\nPassed in / returned / local variable only?→ dependency / uses-a","rawText":"Three-question ownership test\n\nStored as a field for future calls?        → association / has-a\nCreated and logically owned internally?    → composition\nPassed in / returned / local variable only?→ dependency / uses-a","fontSize":17,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Three-question ownership test\n\nStored as a field for future calls?        → association / has-a\nCreated and logically owned internally?    → composition\nPassed in / returned / local variable only?→ dependency / uses-a","autoResize":true,"lineHeight":1.25},
    {"id":"memory-hasa","type":"rectangle","x":70,"y":2470,"width":710,"height":285,"angle":0,"strokeColor":"#f08c00","backgroundColor":"#fff9db","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"g4","roundness":{"type":3},"seed":103,"version":1,"versionNonce":103,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"memory-hasa-text","type":"text","x":95,"y":2492,"width":650,"height":220,"angle":0,"strokeColor":"#5f3dc4","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"g5","roundness":null,"seed":104,"version":1,"versionNonce":104,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Has-a family\n\nAssociation — “I keep your contact.”\nExample: ProviderService stores ProviderFactory.\n\nAggregation — “I have you, but you can live independently.”\nExample: ArtifactResolver stores externally created strategies.\n\nComposition — “You are one of my internal parts.”\nExample: Prompt contains PromptMessage objects.","rawText":"Has-a family\n\nAssociation — “I keep your contact.”\nExample: ProviderService stores ProviderFactory.\n\nAggregation — “I have you, but you can live independently.”\nExample: ArtifactResolver stores externally created strategies.\n\nComposition — “You are one of my internal parts.”\nExample: Prompt contains PromptMessage objects.","fontSize":17,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Has-a family\n\nAssociation — “I keep your contact.”\nExample: ProviderService stores ProviderFactory.\n\nAggregation — “I have you, but you can live independently.”\nExample: ArtifactResolver stores externally created strategies.\n\nComposition — “You are one of my internal parts.”\nExample: Prompt contains PromptMessage objects.","autoResize":true,"lineHeight":1.25},
    {"id":"memory-uses","type":"rectangle","x":860,"y":2470,"width":710,"height":285,"angle":0,"strokeColor":"#f08c00","backgroundColor":"#fff9db","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"g6","roundness":{"type":3},"seed":105,"version":1,"versionNonce":105,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"memory-uses-text","type":"text","x":885,"y":2492,"width":650,"height":220,"angle":0,"strokeColor":"#5f3dc4","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"g7","roundness":null,"seed":106,"version":1,"versionNonce":106,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Uses and creates\n\nDependency / uses-a — “I borrow you for one task.”\nExample: PromptBuilder uses ResolvedArtifact.\n\nCreation dependency — “I create you when requested, but I do not keep you.”\nExample: ProviderFactory returns a provider adapter.\n\nDelegation — “I received the task; a specialist performs it.”\nExample: ProviderService delegates to provider.generate().","rawText":"Uses and creates\n\nDependency / uses-a — “I borrow you for one task.”\nExample: PromptBuilder uses ResolvedArtifact.\n\nCreation dependency — “I create you when requested, but I do not keep you.”\nExample: ProviderFactory returns a provider adapter.\n\nDelegation — “I received the task; a specialist performs it.”\nExample: ProviderService delegates to provider.generate().","fontSize":17,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Uses and creates\n\nDependency / uses-a — “I borrow you for one task.”\nExample: PromptBuilder uses ResolvedArtifact.\n\nCreation dependency — “I create you when requested, but I do not keep you.”\nExample: ProviderFactory returns a provider adapter.\n\nDelegation — “I received the task; a specialist performs it.”\nExample: ProviderService delegates to provider.generate().","autoResize":true,"lineHeight":1.25},
    {"id":"memory-types","type":"rectangle","x":1650,"y":2470,"width":710,"height":285,"angle":0,"strokeColor":"#f08c00","backgroundColor":"#fff9db","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"g8","roundness":{"type":3},"seed":107,"version":1,"versionNonce":107,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"memory-types-text","type":"text","x":1675,"y":2492,"width":650,"height":220,"angle":0,"strokeColor":"#5f3dc4","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"g9","roundness":null,"seed":108,"version":1,"versionNonce":108,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"Type relationships\n\nInheritance / is-a — “I am a specialized form of you.”\nExample: InvalidInputError is-a StructuredOutputError.\n\nProtocol realization / implements-a — “I provide every operation promised by this contract.”\nExample: OCI/OpenAI adapters implement GenerationProvider.\n\nPolymorphism — “One operation, many runtime forms.”\nExample: generate() runs OCI or OpenAI behavior.","rawText":"Type relationships\n\nInheritance / is-a — “I am a specialized form of you.”\nExample: InvalidInputError is-a StructuredOutputError.\n\nProtocol realization / implements-a — “I provide every operation promised by this contract.”\nExample: OCI/OpenAI adapters implement GenerationProvider.\n\nPolymorphism — “One operation, many runtime forms.”\nExample: generate() runs OCI or OpenAI behavior.","fontSize":17,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Type relationships\n\nInheritance / is-a — “I am a specialized form of you.”\nExample: InvalidInputError is-a StructuredOutputError.\n\nProtocol realization / implements-a — “I provide every operation promised by this contract.”\nExample: OCI/OpenAI adapters implement GenerationProvider.\n\nPolymorphism — “One operation, many runtime forms.”\nExample: generate() runs OCI or OpenAI behavior.","autoResize":true,"lineHeight":1.25},
