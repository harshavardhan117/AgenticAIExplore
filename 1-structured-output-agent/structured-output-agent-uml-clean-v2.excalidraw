    {"id":"engine-flow","type":"text","x":100,"y":350,"width":1110,"height":50,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b2","roundness":null,"seed":15,"version":1,"versionNonce":15,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"execute(request)  →  resolve artifact  →  build initial prompt  →  _generate_with_retries()  →  ExecutionResponse\nThe retry helper performs: generate  →  validate  →  repair prompt when invalid  →  retry up to two times.","rawText":"execute(request)  →  resolve artifact  →  build initial prompt  →  _generate_with_retries()  →  ExecutionResponse\nThe retry helper performs: generate  →  validate  →  repair prompt when invalid  →  retry up to two times.","fontSize":19,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"execute(request)  →  resolve artifact  →  build initial prompt  →  _generate_with_retries()  →  ExecutionResponse\nThe retry helper performs: generate  →  validate  →  repair prompt when invalid  →  retry up to two times.","autoResize":true,"lineHeight":1.25},
