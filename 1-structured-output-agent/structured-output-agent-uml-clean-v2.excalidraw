		{
			"id": "tq3Q0lks",
			"type": "text",
			"x": -85.40973581421977,
			"y": 2529.332984542807,
			"width": 693.7272446793563,
			"height": 255,
			"angle": 0,
			"strokeColor": "#343a40",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 1,
