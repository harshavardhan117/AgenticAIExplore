			"isDeleted": false,
			"boundElements": [],
			"updated": 1786602580226,
			"link": null,
			"locked": false,
			"text": "Association\n“I keep your contact.” One object stores a reference to another.\nExample: ProviderService stores ProviderFactory.\n\nAggregation\n“I have you, but you can live independently.” Weak ownership; parts are supplied or\nshareable.\nExample: ArtifactResolver stores independently created strategies.\n\nComposition\n“You are one of my internal parts.” The whole creates/logically owns the part.\nExample: StructuredOutputOrchestrator creates JsonResponseValidator.",
			"rawText": "Association\n“I keep your contact.” One object stores a reference to another.\nExample: ProviderService stores ProviderFactory.\n\nAggregation\n“I have you, but you can live independently.” Weak ownership; parts are supplied or shareable.\nExample: ArtifactResolver stores independently created strategies.\n\nComposition\n“You are one of my internal parts.” The whole creates/logically owns the part.\nExample: StructuredOutputOrchestrator creates JsonResponseValidator.",
			"originalText": "Association\n“I keep your contact.” One object stores a reference to another.\nExample: ProviderService stores ProviderFactory.\n\nAggregation\n“I have you, but you can live independently.” Weak ownership; parts are supplied or shareable.\nExample: ArtifactResolver stores independently created strategies.\n\nComposition\n“You are one of my internal parts.” The whole creates/logically owns the part.\nExample: StructuredOutputOrchestrator creates JsonResponseValidator.",
			"fontSize": 17,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"autoResize": false,
			"lineHeight": 1.25,
			"index": "b0t",
			"hasTextLink": false
		},
